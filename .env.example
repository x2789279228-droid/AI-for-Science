# ========= 科研助手 Agent 环境变量（复制为 .env 后填写；密钥绝不入仓库） =========

# --- LLM（OpenAI 兼容 Chat Completions）可选端点 ---
# 方式 1：DeepSeek（按参赛方案主力）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# 方式 2：火山方舟 Agent Plan 订阅（专属面，model 直填模型名，无需 ep 接入点）
#   注意：Agent Plan 订阅额度官方声明面向 AI 工具场景，自有后端长期部署
#   建议改用方舟控制台「API Key 管理」的按量付费标准 key 走 /api/v3。
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# LLM_API_KEY=ark-xxx
# LLM_THINKING_DISABLED=1   # doubao-seed 系列默认开思考，QA 场景建议关闭
# 方式 3：MiniMax（备选）
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=
# 方式 4：任意 OpenAI 兼容端点
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=sk-xxx

LLM_MODEL=doubao-seed-2.1-lite
LLM_REASONING_MODEL=
LLM_TEMPERATURE=0.1

# --- Embedding（索引时向量化落库；三选一后端 EMBEDDING_BACKEND）---
# api   ：OpenAI 兼容 /embeddings（方舟单批上限 10，代码已按 8 分批+退避重试）
# local ：fastembed 本地 BGE-M3（零 API 依赖，pip 组 chroma 可选装）
# off/auto：纯 BM25 / 有 key 走 api 否则 local
EMBEDDING_BACKEND=api
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
EMBEDDING_MODEL=doubao-embedding-vision
# 本地兜底示例：
# EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=BAAI/bge-m3

# --- 重排（可选，SiliconFlow bge-reranker-v2-m3）---
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 多模态解析兜底（扫描件/困难页，阿里云百炼 Qwen-VL）---
DASHSCOPE_API_KEY=

# --- 运行时 ---
API_PORT=8000
WEB_PORT=3000
# 每日 LLM 调用限额（成本护栏）
DAILY_LLM_LIMIT=2000

# --- 本地解析增强通道（MinerU 2.5.4，独立 venv，宿主机安装；容器内 off 走 PyMuPDF 兜底）---
# auto：可用即用；off：禁用；on：强制（不可用报错）
MINERU_ENABLED=auto
MINERU_CMD=D:\mineru-venv\Scripts\mineru.exe
# 单次解析（或长文档单批）超时秒数；长文档实际超时 = max(此值, min(页数*12, 7200))
MINERU_TIMEOUT_S=1800

# --- VLM 视觉通道（扫描件/困难页）---
# 留空 = 跟随 LLM 端点（火山方舟 doubao-seed 系列本身多模态）；也可显式指到 DashScope qwen-vl
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_ENABLED=1

# --- 长文档 ---
# 全文 chunk/索引页数上限（超出仅入 DocIR 按需阅读）
LONG_DOC_INDEX_PAGES=120

# --- Prompt A/B 开关（app/prompts/*.yaml 的 variants 档位）---
# default | strict，运行时切换无需重启
PROMPT_VARIANT=default

# --- L4 语义校验（claim 能否被证据推出；0 关闭）---
SEMANTIC_JUDGE=1

# --- 工具类（4.4，可选）---
# GitHub 仓库搜索（复现性分）；无 token 限流 10 次/分
GITHUB_TOKEN=

# --- Round4 横切生产化 ---
# 匿名用户限流：重端点 POST 每分钟次数/用户（X-User-Id 或 client host 分桶；0=关闭）
# 口径：单机单进程令牌桶——比赛演示档滥用防护，非多租户鉴权
RATE_LIMIT_PER_MIN=30
