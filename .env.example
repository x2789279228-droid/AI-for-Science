# ========= 科研助手 Agent 环境变量（复制为 .env 后填写；密钥绝不入仓库） =========

# --- LLM（OpenAI 兼容 Chat Completions）三选一 ---
# 方式 1：DeepSeek（主力，按参赛方案）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# 方式 2：MiniMax（备选）
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=
# 方式 3：任意 OpenAI 兼容端点
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=sk-xxx

LLM_MODEL=deepseek-chat
LLM_REASONING_MODEL=deepseek-reasoner
LLM_TEMPERATURE=0.1

# --- Embedding（OpenAI 兼容 /embeddings，如 SiliconFlow BGE-M3）---
# 留空则自动降级：BM25 稀疏检索单路（管线仍支持 RRF 融合）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- 重排（可选，SiliconFlow bge-reranker-v2-m3）---
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 多模态解析兜底（扫描件/困难页，阿里云百炼 Qwen-VL）---
DASHSCOPE_API_KEY=

# --- 运行时 ---
API_PORT=8000
WEB_PORT=3000
# 每日 LLM 调用限额（成本护栏）
DAILY_LLM_LIMIT=2000
