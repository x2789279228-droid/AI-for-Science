{"paper_id": "1706.03762", "meta": {"title": "Attention Is All You Need", "authors": [], "arxiv_id": "1706.03762", "pub_date": "", "venue": "", "page_count": 3, "file": "p_69c87365e66e.pdf"}, "toc": [{"level": 1, "title": "Attention Is All You Need", "page": 0}, {"level": 2, "title": "Abstract", "page": 0}, {"level": 2, "title": "1 Introduction", "page": 0}, {"level": 2, "title": "2 Experiments", "page": 1}, {"level": 2, "title": "References", "page": 2}], "blocks": [{"id": "b1", "type": "paragraph", "text": "Attention Is All You Need", "latex": null, "page": 0, "bbox": [0.121, 0.0534, 0.3826, 0.0762], "section_path": ""}, {"id": "b2", "type": "paragraph", "text": "Anna Author, Bob Chen, Carol Li", "latex": null, "page": 0, "bbox": [0.121, 0.0883, 0.3413, 0.103], "section_path": ""}, {"id": "b3", "type": "paragraph", "text": "arXiv:1706.03762v7", "latex": null, "page": 0, "bbox": [0.121, 0.1109, 0.2406, 0.124], "section_path": ""}, {"id": "b4", "type": "heading", "text": "Abstract", "latex": null, "page": 0, "bbox": [0.121, 0.1333, 0.196, 0.1513], "section_path": "Abstract"}, {"id": "b5", "type": "paragraph", "text": "We propose the Transformer, the first sequence model based solely on attention. It achieves state-of-the-art\nresults on machine translation.", "latex": null, "page": 0, "bbox": [0.121, 0.1663, 0.8432, 0.1967], "section_path": "Abstract"}, {"id": "b6", "type": "paragraph", "text": "1 Introduction", "latex": null, "page": 0, "bbox": [0.121, 0.2592, 0.2443, 0.2772], "section_path": "Attention Is All You Need"}, {"id": "b7", "type": "paragraph", "text": "Recurrent neural networks have long dominated sequence modeling. We replace recurrence entirely with\nself-attention.", "latex": null, "page": 0, "bbox": [0.121, 0.2922, 0.8238, 0.3226], "section_path": "Attention Is All You Need"}, {"id": "b8", "type": "heading", "text": "2 Experiments", "latex": null, "page": 1, "bbox": [0.121, 0.0573, 0.2474, 0.0753], "section_path": "2 Experiments"}, {"id": "b9", "type": "paragraph", "text": "The big model was trained on 8 NVIDIA P100 GPUs\nand took 3.5 days.", "latex": null, "page": 1, "bbox": [0.121, 0.095, 0.4707, 0.1255], "section_path": "2 Experiments"}, {"id": "b10", "type": "paragraph", "text": "The base model reaches 27.3 BLEU on WMT 2014\nEnglish-to-German.", "latex": null, "page": 1, "bbox": [0.5168, 0.095, 0.8598, 0.1255], "section_path": "2 Experiments"}, {"id": "b11", "type": "heading", "text": "References", "latex": null, "page": 2, "bbox": [0.121, 0.0573, 0.2207, 0.0753], "section_path": "References"}, {"id": "b12", "type": "paragraph", "text": "[1] Vaswani et al. 2017. Attention Is All You Need. arXiv:1706.03762", "latex": null, "page": 2, "bbox": [0.121, 0.0998, 0.5268, 0.1128], "section_path": "References"}, {"id": "b13", "type": "paragraph", "text": "[2] Bahdanau et al. 2015. Neural machine translation by jointly learning to align and translate.", "latex": null, "page": 2, "bbox": [0.121, 0.1401, 0.6748, 0.1532], "section_path": "References"}], "tables": [], "figures": [], "references": [{"index": 1, "raw": "Vaswani et al. 2017. Attention Is All You Need. arXiv:1706.03762", "title": "2017", "arxiv_id": "1706.03762", "doi": ""}, {"index": 2, "raw": "Bahdanau et al. 2015. Neural machine translation by jointly learning to align and translate.", "title": "2015", "arxiv_id": "", "doi": ""}]}